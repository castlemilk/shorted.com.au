{
  "name": "shorted",
  "version": "v0.2.2-1271-ge644fdc3-dirty",
  "private": true,
  "type": "module",
  "moduleResolution": "Node",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "npm run bump-version",
    "build": "next build",
    "postbuild": "sh scripts/warm-cache-on-deploy.sh || true",
    "build:analyze": "ANALYZE=true next build",
    "lighthouse": "node scripts/lighthouse-ci.js",
    "perf:check": "npm run build && npm run start & sleep 5 && npm run lighthouse",
    "perf:bench": "node scripts/perf-benchmark.mjs",
    "perf:compare": "node scripts/perf-benchmark.mjs --compare ../docs/perf/baseline-2026-06.json",
    "perf:lh": "node scripts/lighthouse-bench.mjs",
    "perf:lh:desktop": "node scripts/lighthouse-bench.mjs --desktop",
    "perf:lh:compare": "node scripts/lighthouse-bench.mjs --compare ../docs/perf/lh-baseline.mobile.json",
    "perf:lh:baseline": "node scripts/lighthouse-bench.mjs --update-baseline ../docs/perf/lh-baseline.mobile.json",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bundle:compare": "node scripts/bundle-budget.mjs --compare ../docs/perf/bundle-baseline.json",
    "bundle:baseline": "node scripts/bundle-budget.mjs --update-baseline ../docs/perf/bundle-baseline.json",
    "dev": "APP_VERSION=`git describe --tags --always --dirty` next dev -p 3020",
    "bump-version": "sh ./scripts/bump-version.sh",
    "lint": "next lint --max-warnings=1000",
    "start": "next start -p 3020",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cache": "jest --testPathPattern='cache|warm-cache|page-server'",
    "test:cache:manual": "bash scripts/test-cache.sh",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:stripe-testmode": "playwright test --config playwright.stripe-testmode.config.ts",
    "firebase:preflight": "tsx scripts/validate-firebase-client-config.ts",
    "stripe:preflight": "tsx scripts/validate-stripe-checkout-prices.ts",
    "test:e2e:report": "playwright show-report",
    "test:storybook": "vitest run --project=storybook",
    "test:visual": "npm run storybook:build && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "npm run storybook:build && playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:e2e:full": "bash ../scripts/run-e2e-tests.sh",
    "test:seed": "tsx scripts/test-db-setup.ts",
    "sync-short-data": "node --loader ts-node/esm scripts/sync-short-data.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/db-setup.ts --seed",
    "db:sync-asic": "tsx scripts/sync-asic-data.ts",
    "db:sync-asic:week": "tsx scripts/sync-asic-data.ts --days 7",
    "db:sync-asic:month": "tsx scripts/sync-asic-data.ts --days 30",
    "db:sync-market": "tsx scripts/sync-market-data.ts",
    "db:sync-market:week": "tsx scripts/sync-market-data.ts --days 7",
    "db:sync-market:month": "tsx scripts/sync-market-data.ts --days 30",
    "db:sync-market:backfill": "tsx scripts/sync-market-data.ts --backfill --days 90",
    "db:sync-all": "npm run db:sync-asic && npm run db:sync-market",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:migrate": "supabase db push",
    "algolia:sync": "tsx scripts/sync-algolia.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@/auth$": "<rootDir>/src/test/__mocks__/@/auth.js",
      "^next-auth/react$": "<rootDir>/src/test/__mocks__/next-auth-react.js",
      "^uncrypto$": "<rootDir>/src/test/__mocks__/uncrypto.js",
      "^@radix-ui/react-progress$": "<rootDir>/src/test/__mocks__/@radix-ui/react-progress.js",
      "^d3-geo$": "<rootDir>/src/test/__mocks__/d3-geo.js",
      "^d3-zoom$": "<rootDir>/src/test/__mocks__/d3-zoom.js",
      "^d3-selection$": "<rootDir>/src/test/__mocks__/d3-selection.js",
      "^d3-scale$": "<rootDir>/src/test/__mocks__/d3-scale.js",
      "^d3-scale-chromatic$": "<rootDir>/src/test/__mocks__/d3-scale-chromatic.js",
      "^topojson-client$": "<rootDir>/src/test/__mocks__/topojson-client.js",
      "^@/lib/utils$": "<rootDir>/src/@/lib/utils.ts",
      "^@/(.*)$": "<rootDir>/src/@/$1",
      "^~/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/scripts/**/*.test.ts",
      "**/src/**/*.test.ts",
      "**/src/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx"
          },
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@bufbuild|@connectrpc|next-auth|@auth|firebase|firebase-admin|jose|jwks-rsa|@visx|d3-array|d3-scale|d3-shape|d3-time|d3-format|@upstash|uncrypto)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/src/gen/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/test/**/*",
      "!src/gen/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 40,
        "lines": 40,
        "statements": 40
      }
    }
  },
