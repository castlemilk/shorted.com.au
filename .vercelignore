# Vercel project root is configured as `web/`. Exclude unrelated monorepo
# areas and local/generated artifacts from CLI uploads.
# NOTE: unanchored dir patterns follow .gitignore semantics and match at ANY
# depth — `scripts/` used to swallow web/scripts/ (bump-version.sh), breaking
# CLI builds with exit 127. Keep repo-root-only excludes anchored with `/`.
/services/
/terraform/
/sdks/
/docs/
/scripts/
/supabase/
/bin/
node_modules/
.next/
.turbo/
coverage/
playwright-report/
test-results/
.vercel/output/
.vercel/node/
.playwright-cli/
.playwright-mcp/
.serena/
.worktrees/
2026-*.txt
/analysis/
/proto/
/output/
# Root-level review screenshots (anchored: web/public assets unaffected)
/*.png
/*.jpeg
web/storybook-static/

# Local/generated web app artifacts
web/.next/
web/node_modules/
web/.turbo/
web/coverage/
web/playwright-report/
web/test-results/
web/.vercel/output/
web/.cache/
web/tmp/
web/temp/
web/tsconfig.tsbuildinfo
web/lighthouse-report.json
web/home-page.png
web/dashboard-page.png
web/.env*

# Local-only diagnostics and scratch files
web/.playwright*/
web/scripts/geo/
web/scripts/housing-icons/
web/scripts/dbg-*.mjs
web/scripts/verify-*.mjs
