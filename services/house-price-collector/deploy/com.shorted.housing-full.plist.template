<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- PERIODIC FULL housing re-crawl — the whole catalog, drained to empty, then the
     freshness alarm. This is the "reset the baseline" pass that re-reaches quiet
     suburbs the daily delta never re-selects and re-confirms delists catalog-wide.
     Pairs with the daily com.shorted.housing-delta.plist.template. Replace __REPO__
     with this checkout's absolute path and __HOME__ with the operator's home dir. -->
<dict>
  <key>Label</key><string>com.shorted.housing-full</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/services/house-price-collector/deploy/run-housing-full.sh</string>
  </array>

  <!-- Fortnightly: the 1st and 15th at 08:00 local. Daytime is intentional:
       observed REA/Kasada clearance and block reliability degrades late at night,
       so do not move this back to the legacy overnight window. A full pass over the whole
       catalog (500 suburbs x 2 portals at ~14 suburbs/hr) takes ~1.5 DAYS on one
       residential IP, so it DOES overrun the daily 10:00 delta — rescheduling can't
       fix a >1-day job. The wrappers share a cross-run lock (hc_acquire_lock in
       housing-crawl-common.sh): while a full pass holds it, each daily delta SKIPS
       cleanly (the full already re-crawls everything), so they never contend for the
       one host Chrome / residential IP. launchd runs whichever day-of-month entry
       matches. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Day</key><integer>1</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Day</key><integer>15</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key><string>__HOME__/Library/Logs/shorted-housing-full.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/shorted-housing-full.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
