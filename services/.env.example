# Database Configuration
# For Supabase, use the connection string from your Supabase dashboard
DATABASE_URL=postgresql://user:password@host:port/database

# Google Cloud Configuration (for deployments)
GCP_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Stock Price Service Configuration
STOCK_PRICE_SERVICE_URL=https://your-service.run.app

# Local Development Database (optional)
LOCAL_DATABASE_URL=postgresql://admin:password@localhost:5432/shorts

# ---------------------------------------------------------------------------
# Algolia search
# ---------------------------------------------------------------------------
# Used by `make register-index` (the Registers of Members'/Senators' Interests
# search index) and the market-data stock sync.
#
# THE WRITE KEY IS NOT THE SEARCH KEY. The search key is public — it is served to
# browsers — and cannot create or write an index; a build with only that key
# fails with a permissions error from Algolia. Copy the Write API Key from
# Algolia dashboard -> Settings -> API Keys.
ALGOLIA_APP_ID=your-app-id
ALGOLIA_WRITE_KEY=your-write-key
# Read-only, safe to expose. Also set in the web app and the Makefile default.
ALGOLIA_SEARCH_KEY=your-search-key

# Optional: point the register index somewhere else while experimenting, so a
# trial run cannot touch the index the live site searches.
#   make register-index ALGOLIA_POLITICIANS_INDEX=politicians_dev
# ALGOLIA_POLITICIANS_INDEX=politicians

# Example for Supabase (DO NOT COMMIT ACTUAL VALUES):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres