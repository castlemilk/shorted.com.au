# syntax=docker/dockerfile:1
# Test-specific Dockerfile for shorts service

# Default empty stage for local stealth source (overridden by --build-context stealth=...)
FROM scratch AS stealth

FROM golang:1.26.0-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./

# Download dependencies:
# 1. If github_token secret is available (CI), use it for private module auth
# 2. If local stealth source is provided via build context, use go mod replace
#    The replace directive is preserved through the build so `go build` also works
# 3. Otherwise fail (private module requires auth)
RUN --mount=type=secret,id=github_token \
    --mount=type=bind,from=stealth,target=/stealth-src \
    if [ -f /run/secrets/github_token ]; then \
      git config --global url."https://x-access-token:$(cat /run/secrets/github_token)@github.com/skunkworq/".insteadOf "https://github.com/skunkworq/"; \
    elif [ -f /stealth-src/go.mod ]; then \
      cp -r /stealth-src /stealth && \
      go mod edit -replace github.com/skunkworq/stealth=/stealth && \
      cp go.mod /tmp/go.mod.stealth; \
    fi && \
    GOPRIVATE=github.com/skunkworq/* GONOSUMCHECK=github.com/skunkworq/* go mod download && \
    rm -f ~/.gitconfig

COPY . .

# Restore stealth replace directive if using local source (COPY . . overwrites go.mod)
RUN [ -f /tmp/go.mod.stealth ] && cp /tmp/go.mod.stealth go.mod || true

RUN go build -o shorts-service ./shorts/cmd/server

FROM alpine:3.19
RUN apk --no-cache add ca-certificates curl
WORKDIR /root/

COPY --from=builder /app/shorts-service .

# Add health check endpoint for testing
EXPOSE 8080

CMD ["./shorts-service"]
